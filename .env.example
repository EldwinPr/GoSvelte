# Server Configuration
PORT=8080
ENV=development

# Database Configuration
# For SQLite:
DB_PATH=system.db

# For PostgreSQL (future use):
# format: host=localhost user=user password=pass dbname=erp port=5432 sslmode=disable
DB_DSN=host=localhost user=user password=pass dbname=erp port=5432 sslmode=disable

# Security
SESSION_SECRET=your-super-secret-key-here
